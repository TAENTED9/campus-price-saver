# ============================================================================
#  CAMPIFY BACKEND — Environment Variables
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit `.env` — it's already in .gitignore.
# ============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
# development | production. Controls cookie security, CORS, and debug output.
ENVIRONMENT=development
APP_ENV=development

# Public URL of your deployed frontend — used in email links and CORS.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (no spaces).
# Always include http://localhost:3000 for local dev.
ALLOWED_ORIGINS=http://localhost:3000,https://campify.digital,https://www.campify.digital

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate fresh values for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_API_KEY=change-me-to-a-different-random-string

# JSON array of admin usernames allowed to use the admin login endpoint
ADMIN_USERNAMES=["admin"]

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to fall back to SQLite (data.db) for local dev.
# Set to a Supabase Session-mode URL (port 5432) in production.
DATABASE_URL=
USE_SQLITE=true
DATABASE_ECHO=false

# Supabase access (optional — only needed when applying migrations via psql)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com — free tier = 100 emails/day.
# Get your API key from https://resend.com/api-keys.
RESEND_API_KEY=

# The "From" header on outgoing emails. MUST be a Resend-verified sender.
# Format:  Display Name <verified@your-domain>
# If left blank, emails are silently skipped rather than sent from a wrong address.
RESEND_FROM=

# Optional override — if set, takes precedence over RESEND_FROM.
EMAIL_FROM=

# Optional dedicated "From" for notification-type emails (price drops, etc).
# Falls back to EMAIL_FROM / RESEND_FROM when unset.
EMAIL_FROM_NOTIFICATIONS=

# Inbox that receives admin notifications (new seller verifications, etc.)
ADMIN_EMAIL=

# Inbox that receives contact-form / support messages.
# Used as the To: address for /api/contact submissions, and shown in
# email footers as the "Need help?" link. Leave blank to hide from emails.
SUPPORT_EMAIL=

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
# Sign up free at https://cloudinary.com — free tier = 25 GB storage.
# Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Maps (optional, for store-locator feature) ────────────────────────
# Leave blank to disable the map feature.
GOOGLE_MAPS_API_KEY=

# ── File uploads (local fallback) ────────────────────────────────────────────
# Used by admin_items.py when Cloudinary isn't in the flow.
UPLOAD_DIR=./uploads/submissions

# ── Server / API ─────────────────────────────────────────────────────────────
# Local-only listen address. Vercel / Render override these via PORT.
API_HOST=0.0.0.0
API_PORT=8000
# Optional — used internally if the API needs to call itself by URL.
API_BASE_URL=http://localhost:8000

# ── Redis + Celery ───────────────────────────────────────────────────────────
# When running via docker-compose, the hostname is `redis`.
# When running uvicorn locally without docker, use `localhost`.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Celery Flower (monitoring UI) — production credentials
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
