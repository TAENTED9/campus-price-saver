# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for local SQLite (data.db) development
# Set to Supabase Session-mode URL (port 5432) in production
DATABASE_URL=

# Supabase project-level access (optional, for migrations via psql)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth & Cookies ────────────────────────────────────────────────────────────
ADMIN_API_KEY=change-me
ADMIN_USERNAMES=admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://campify.ng,https://www.campify.ng
FRONTEND_URL=https://campify.ng

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Campify <noreply@campify.ng>

# ── App URLs & Admin ──────────────────────────────────────────────────────────
APP_URL=https://campify.ng
ADMIN_EMAIL=admin@campify.ng
SUPPORT_EMAIL=support@campify.ng

# ── Misc ─────────────────────────────────────────────────────────────────────
DATABASE_ECHO=false
