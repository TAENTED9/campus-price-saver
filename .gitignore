# =====================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python environments
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Python testing / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =====================================================
# Environment Variables (NEVER COMMIT)
# =====================================================
.env
.env.*
*.env

# =====================================================
# Databases
# =====================================================
*.db
*.sqlite
*.sqlite3

# =====================================================
# Logs
# =====================================================
*.log
logs/*.log
# Keep the logs/ directory itself (tracked via logs/.gitkeep)
!logs/.gitkeep

